rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Depuis la migration vers le serveur Node.js (server/), plus AUCUN
// navigateur ne touche Firestore directement : seul le serveur y accède,
// via le SDK Admin (clé de service secrète, variable d'environnement
// Render — jamais dans le dépôt public). Le SDK Admin ignore de toute
// façon ces règles, mais on refuse tout accès client ici en défense en
// profondeur, au cas où quelqu'un retrouverait l'identifiant du projet
// Firebase et tenterait d'y accéder avec sa propre configuration.
//
// C'est ce verrouillage qui ferme les failles décrites dans l'audit de
// sécurité (rôle auto-déclaré, PIN lisibles, tables truquables, soldes
// modifiables par n'importe qui) : avant, ces règles ne pouvaient
// valider que la FORME des données, jamais l'identité de qui écrivait.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
